# Source: https://argo-cd.readthedocs.io/en/stable/operator-manual/argocd-tls-certs-cm-yaml/

apiVersion: v1
kind: ConfigMap
metadata:
  name: argocd-tls-certs-cm
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-cm
    app.kubernetes.io/part-of: argocd
data:
  server.example.com: |
    -----BEGIN CERTIFICATE-----
            [REDACTED]
    -----END CERTIFICATE-----
