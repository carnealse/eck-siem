input {
  pipeline {
    address => "c2imera"
    id => "0000-cimera-input"
  }
}

filter {
  # Detects if the log starts with the CloudWatch/AWS wrapper pattern
  if [message] =~ /^{"messageType":/ {

    # 1. Parse the wrapper into c2imera top field
    json {
      source => "message"
      target => "[c2imera]"
    }

    # Record when we received the log before we potentially overwrite @timestamp
    mutate {
      copy => { "@timestamp" => "[event][created]" }
    }

    # 2. Extract the actual log line
    if [c2imera][message] {
      # Overwrite the main message field with the inner log so 
      # the Gatekeeper and Lanes see the raw log text.
      mutate { 
        replace => { "message" => "%{[c2imera][message]}" }
      }
    }
  }
}
