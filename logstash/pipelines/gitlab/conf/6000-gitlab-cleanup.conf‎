filter {
  # field clean up
  mutate {
    id => "6000-gitlab-cleanup-mutate-3"
      remove_field => ["[host]", "[user_agent][original]", "[http]"]
  }

  if "_mutate_error" in [tags] and ![error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-gitlab-cleanup.conf"
        "[error][source_plugin_id]" => "6000-gitlab-cleanup-mutate-3"
      }
    }
  }
}
