filter {
  # field clean up
  mutate {
    id => "6000-gitlab-remove-fields-mutate-01"
      remove_field => ["[host]", "[user_agent][original]", "[http]"]
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-gitlab-remove-fields-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "6000-gitlab-cleanup.conf"
      }
    }
  }
}
