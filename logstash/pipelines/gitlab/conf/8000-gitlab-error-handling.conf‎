filter {
  # Restore generic failure tags after per-plugin attribution removes them to avoid false matches.
  if "_logstash_attributed_mutate_error" in [tags] and !("_mutate_error" in [tags]) {
    mutate {
      id => "8000-gitlab-restore-mutate-error-tag"
      add_tag => ["_mutate_error"]
    }
  }

  if "_logstash_attributed_ruby_exception" in [tags] and !("_rubyexception" in [tags]) {
    mutate {
      id => "8000-gitlab-restore-ruby-exception-tags"
      add_tag => ["_rubyexception", "ruby_exception"]
    }
  }

  if "_jsonparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-jsonparsefailure-add"
        add_field => { "[error][message]" => "json parsing failed" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-jsonparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | json parsing failed" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_dateparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-dateparsefailure-add"
        add_field => { "[error][message]" => "date parsing failed" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-dateparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | date parsing failed" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_mutate_error" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-mutate-error-add"
        add_field => { "[error][message]" => "mutate error occurred" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-mutate-error-update"
        update => { "[error][message]" => "%{[error][message]} | mutate error occurred" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-rubyexception-add"
        add_field => { "[error][message]" => "An exception occurred in the ruby code" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-rubyexception-update"
        update => { "[error][message]" => "%{[error][message]} | An exception occurred in the ruby code" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_geoip_lookup_failure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-geoip-lookup-failure-add"
        add_field => { "[error][message]" => "geoip lookup failed" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-geoip-lookup-failure-update"
        update => { "[error][message]" => "%{[error][message]} | geoip lookup failed" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_grokparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-grokparsefailure-add"
        add_field => { "[error][message]" => "grok parsing failed" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-grokparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | grok parsing failed" }
        add_tag => ["filter_error"]
      }
    }
  }

  if "_grok_kv_parse_failure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-gitlab-grok-kv-parse-failure-add"
        add_field => { "[error][message]" => "grok kv parsing failed" }
        add_tag => ["filter_error"]
      }
    } else {
      mutate {
        id => "8000-gitlab-grok-kv-parse-failure-update"
        update => { "[error][message]" => "%{[error][message]} | grok kv parsing failed" }
        add_tag => ["filter_error"]
      }
    }
  }

  # Consolidate all filter errors under one tag and stamp pipeline metadata
  if "filter_error" in [tags] {
    mutate {
      id => "8000-gitlab-pipeline-error-consolidation"
      add_tag => ["pipeline_processing_error"]
      replace => {
        "[error][source_pipeline]" => "gitlab"
        "[error][event_status]"    => "processing_failure"
      }
    }
  }

  # Keep dashboard attribution fields present when a failure tag was not stamped at source.
  if "pipeline_processing_error" in [tags] and ![error][source_plugin_id] {
    mutate {
      id => "8000-gitlab-source-attribution-fallback"
      add_field => {
        "[error][source_config]"    => "unknown"
        "[error][source_plugin_id]" => "unknown"
      }
    }
  }

  # Fallback generic error message if none was set
  if "pipeline_processing_error" in [tags] and ![error][message] {
    mutate {
      id => "8000-gitlab-generic-error-message"
      add_field => { "[error][message]" => "gitlab generic pipeline processing failure" }
    }
  }

  # Set routing path for 9000 output
  if "pipeline_processing_error" in [tags] {
    mutate {
      id => "8000-gitlab-routing-error"
      replace => { "[@metadata][routing_path]" => "error_index" }
    }
  } else {
    mutate {
      id => "8000-gitlab-routing-standard"
      replace => { "[@metadata][routing_path]" => "standard_index" }
    }
  }
}
