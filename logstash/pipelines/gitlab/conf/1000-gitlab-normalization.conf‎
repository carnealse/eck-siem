filter {
  # Basic Housekeeping #
  fingerprint {
    source => "message"
    target => "[@metadata][fingerprint]"
    method => "SHA256"
  }

  mutate {
    id => "1000-gitlab-initialize-ecs-mutate-01"
    add_tag => ["logstash"]
    add_field => {"[ecs][version]" => "8.0.0"}
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-gitlab-initialize-ecs-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  json {
    id => "1000-gitlab-gitlab_json_parse-json-01"
    source => "message"
    target => "gitlab"
    tag_on_failure => ["_jsonparsefailure"]
  }

  if "_jsonparsefailure" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-gitlab-gitlab_json_parse-json-01"
      }
      add_tag => ["_logstash_attributed_json_parse_failure"]
      remove_tag => ["_jsonparsefailure"]
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-gitlab-normalization.conf"
      }
    }
  }
}
