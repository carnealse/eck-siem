filter {
  # Basic Housekeeping #
  fingerprint {
    source => "message"
    target => "[@metadata][fingerprint]"
    method => "SHA256"
  }

  mutate {
    id => "1000-gitlab-initialize-ecs-mutate-01"
    add_tag => ["logstash"]
    add_field => {"[ecs][version]" => "8.0.0"}
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-gitlab-normalization.conf"
        }
      }
    }

    if [error][source_plugin_id] {
      mutate {
        update => {
          "[error][source_plugin_id]" => "%{[error][source_plugin_id]} | 1000-gitlab-initialize-ecs-mutate-01"
        }
      add_tag => ["_logstash_failure__1000-gitlab-normalization__mutate__1000-gitlab-initialize-ecs-mutate-01", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
      }
    } else {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-gitlab-initialize-ecs-mutate-01"
        }
      add_tag => ["_logstash_failure__1000-gitlab-normalization__mutate__1000-gitlab-initialize-ecs-mutate-01", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
      }
    }
  }

  json {
    id => "1000-gitlab-gitlab_json_parse-json-01"
    source => "message"
    target => "gitlab"
    tag_on_failure => ["_jsonparsefailure", "_logstash_failure__1000-gitlab-normalization__json__1000-gitlab-gitlab_json_parse-json-01"]
  }

  if "_logstash_failure__1000-gitlab-normalization__json__1000-gitlab-gitlab_json_parse-json-01" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-gitlab-normalization.conf"
        }
      }
    }

    if [error][source_plugin_id] {
      mutate {
        update => {
          "[error][source_plugin_id]" => "%{[error][source_plugin_id]} | 1000-gitlab-gitlab_json_parse-json-01"
        }
      }
    } else {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-gitlab-gitlab_json_parse-json-01"
        }
      }
    }
  }
}
