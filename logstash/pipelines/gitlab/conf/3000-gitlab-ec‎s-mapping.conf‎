filter {
  # Rename fields #
  mutate {
    id => "3000-gitlab-gitlab_field_renames-mutate-01"
    rename => {
      "[gitlab][entity_id]"             => "[gitlab][entity][id]"
      "[gitlab][entity_type]"           => "[gitlab][entity][type]"
      "[gitlab][entity_path]"           => "[gitlab][entity][path]"
      "[gitlab][author_id]"             => "[user][id]"
      "[gitlab][author_name]"           => "[user][name]"
      "[gitlab][target_id]"             => "[gitlab][target][id]"
      "[gitlab][target_type]"           => "[gitlab][target][type]"
      "[gitlab][target_details]"        => "[gitlab][target][details]"
      "[gitlab][ip_address]"            => "[source][ip]"
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "3000-gitlab-ecs-mapping.conf"
        "[error][source_plugin_id]" => "3000-gitlab-gitlab_field_renames-mutate-01"
      }
      add_tag => ["_logstash_failure__3000-gitlab-ecs-mapping__mutate__3000-gitlab-gitlab_field_renames-mutate-01", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # add tag to ensure no pipelines remove event original
  mutate {
    id => "3000-gitlab-preserve-original-tag-mutate-02"
    add_tag => ["preserve_original_event"]
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "3000-gitlab-ecs-mapping.conf"
        "[error][source_plugin_id]" => "3000-gitlab-preserve-original-tag-mutate-02"
      }
      add_tag => ["_logstash_failure__3000-gitlab-ecs-mapping__mutate__3000-gitlab-preserve-original-tag-mutate-02", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
}
