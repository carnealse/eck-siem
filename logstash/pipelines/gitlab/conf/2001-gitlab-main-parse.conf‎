filter {
  mutate {
    id => "2001-gitlab-rename-message-original-mutate-01"
    rename => { "message" => "[event][original]" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "2001-gitlab-rename-message-original-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  if [gitlab][created_at] {
    date {
      id => "2001-gitlab-date-created-at-date-01"
      match => ["[gitlab][created_at]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][created_at]"]
      tag_on_failure => ["_dateparsefailure"]
    }

    if "_dateparsefailure" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2001-gitlab-date-created-at-date-01"
        }
        add_tag => ["_logstash_attributed_date_parse_failure"]
        remove_tag => ["_dateparsefailure"]
      }
    }
  }
  if [gitlab][@timestamp] {
    date {
      id => "2001-gitlab-date-timestamp-date-02"
      match => ["[gitlab][@timestamp]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][@timestamp]"]
      tag_on_failure => ["_dateparsefailure"]
    }

    if "_dateparsefailure" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2001-gitlab-date-timestamp-date-02"
        }
        add_tag => ["_logstash_attributed_date_parse_failure"]
        remove_tag => ["_dateparsefailure"]
      }
    }
  }

  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "2001-gitlab-main-parse.conf"
      }
    }
  }
}
