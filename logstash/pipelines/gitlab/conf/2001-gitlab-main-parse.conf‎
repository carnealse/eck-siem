filter {
  mutate {
    id => "2001-gitlab-rename-message-original-mutate-01"
    rename => { "message" => "[event][original]" }
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "2001-gitlab-main-parse.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "2001-gitlab-rename-message-original-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  if [gitlab][created_at] {
    date {
      id => "2001-gitlab-date-created-at-date-01"
      match => ["[gitlab][created_at]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][created_at]"]
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-created-at-date-01"]
    }

    if "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-created-at-date-01" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "2001-gitlab-main-parse.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2001-gitlab-date-created-at-date-01"
        }
        remove_tag => ["_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-created-at-date-01"]
      }
    }
  }
  if [gitlab][@timestamp] {
    date {
      id => "2001-gitlab-date-timestamp-date-02"
      match => ["[gitlab][@timestamp]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][@timestamp]"]
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-timestamp-date-02"]
    }

    if "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-timestamp-date-02" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "2001-gitlab-main-parse.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2001-gitlab-date-timestamp-date-02"
        }
        remove_tag => ["_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-timestamp-date-02"]
      }
    }
  }
}
