filter {
  mutate {
    id => "2001-gitlab-rename-message-original-mutate-01"
    rename => { "message" => "[event][original]" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "2001-gitlab-main-parse.conf"
        "[error][source_plugin_id]" => "2001-gitlab-rename-message-original-mutate-01"
      }
      add_tag => ["_logstash_failure__2001-gitlab-main-parse__mutate__2001-gitlab-rename-message-original-mutate-01", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  if [gitlab][created_at] {
    date {
      id => "2001-gitlab-date-created-at"
      match => ["[gitlab][created_at]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][created_at]"]
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-created-at"]
    }

    if "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-created-at" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2001-gitlab-main-parse.conf"
          "[error][source_plugin_id]" => "2001-gitlab-date-created-at"
        }
      }
    }
  }
  if [gitlab][@timestamp] {
    date {
      id => "2001-gitlab-date-timestamp"
      match => ["[gitlab][@timestamp]", "UNIX_MS", "ISO8601", "UNIX"]
      target => "@timestamp"
      remove_field => ["[gitlab][@timestamp]"]
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-timestamp"]
    }

    if "_logstash_failure__2001-gitlab-main-parse__date__2001-gitlab-date-timestamp" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2001-gitlab-main-parse.conf"
          "[error][source_plugin_id]" => "2001-gitlab-date-timestamp"
        }
      }
    }
  }
}
