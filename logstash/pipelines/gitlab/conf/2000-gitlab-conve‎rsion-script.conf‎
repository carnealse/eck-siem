filter {
  # convert to object if a string comes through for custom_message
  if [gitlab][details][custom_message] {
    ruby {
      id => "2000-gitlab-custom-message-conversion-ruby-01"
      code => '
        if event.get("[gitlab][details][custom_message]").is_a?(String)
          action = event.get("[gitlab][details][custom_message]")
          event.remove("[gitlab][details][custom_message]")
          event.set("[gitlab][details][custom_message][action]", action)
        end
      '
      tag_on_exception => "_rubyexception"
    }

    if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2000-gitlab-custom-message-conversion-ruby-01"
        }
        add_tag => ["_logstash_attributed_ruby_exception"]
        remove_tag => ["ruby_exception", "_rubyexception"]
      }
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "2000-gitlab-conversion-script.conf"
      }
    }
  }
}
