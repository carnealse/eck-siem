filter {
  # convert to object if a string comes through for custom_message
  if [gitlab][details][custom_message] {
    ruby {
      id => "2000-gitlab-custom-message-conversion-ruby-01"
      code => '
        if event.get("[gitlab][details][custom_message]").is_a?(String)
          action = event.get("[gitlab][details][custom_message]")
          event.remove("[gitlab][details][custom_message]")
          event.set("[gitlab][details][custom_message][action]", action)
        end
      '
      tag_on_exception => "_rubyexception"
    }

    if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "2000-gitlab-custom-message-conversion-ruby-01"
        }
        add_tag => ["_logstash_attributed_ruby_exception"]
        remove_tag => ["ruby_exception", "_rubyexception"]
      }
    }
  }


  # required to check the [error][source_config] array as LS evaluation has limitations with arrays
  ruby {
    id => "2000-gitlab-conversion-script-source-config-fallback"
    code => '
      plugin_ids = event.get("[error][source_plugin_id]")
      if plugin_ids
        ids_array = plugin_ids.is_a?(Array) ? plugin_ids : [plugin_ids]
        has_match = ids_array.any? { |id| id.to_s.start_with?("2000-gitlab") }
        if has_match
          configs = event.get("[error][source_config]")
          configs_array = configs.nil? ? [] : (configs.is_a?(Array) ? configs : [configs])
          unless configs_array.include?("2000-gitlab-conversion-script.conf")
            event.set("[_temp][config_boolean]", "true")
          end
        end
      end
    '
  }

  if [_temp][config_boolean] == "true" {
    mutate {
      add_field => {
        "[error][source_config]" => "2000-gitlab-conversion-script.conf"
      }
      remove_field => ["[_temp]"]
    }
  }
}
