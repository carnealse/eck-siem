filter {
  if [@metadata][log_lane] == "java_lane" {
    # 1. Generic Java Header (Priority List)
    grok {
      id => "2001-c2imera-java-header-grok"
      match => {
        "message" => [
          # Pattern 1: Message + OID (Priority)
          "^%{DATA:raw_ts}\s+%{JAVACLASS:[log][logger]}\s+(?:%{LOGLEVEL:[log][level]}|FINE|FINER|FINEST)\s+\[%{DATA:[process][thread][name]}\]\s+-\s+%{GREEDYDATA:app_message} \(OID:%{DATA:[trace][id]}\)\s*$",
          # Pattern 2: Message Only (Fallback)
          "^%{DATA:raw_ts}\s+%{JAVACLASS:[log][logger]}\s+(?:%{LOGLEVEL:[log][level]}|FINE|FINER|FINEST)\s+\[%{DATA:[process][thread][name]}\]\s+-\s+%{GREEDYDATA:app_message}\s*$"
        ]
      }
    }

    if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2001-c2imera-java.conf"
          "[error][source_plugin_id]" => "2001-c2imera-java-header-grok"
        }
      }
    }

    date {
      id => "2001-c2imera-java-date"
      match => [ "raw_ts", "yyyyMMddHHmmssSSS" ]
      target => "@timestamp"
    }

    if "_dateparsefailure" in [tags] and ![error][source_plugin_id] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2001-c2imera-java.conf"
          "[error][source_plugin_id]" => "2001-c2imera-java-date"
        }
      }
    }

    # Topic 1: aws.SsmConfiguration
    if [log][logger] == "aws.SsmConfiguration" {
      grok {
        id => "2001-c2imera-java-ssm-grok"
        match => { "app_message" => "%{DATA:ssm_action}: \[%{DATA:ssm_content}\]" }
      }

      if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2001-c2imera-java.conf"
            "[error][source_plugin_id]" => "2001-c2imera-java-ssm-grok"
          }
        }
      }

      if [ssm_action] == "Finished reload" {
        kv {
          id => "2001-c2imera-java-ssm-kv"
          source => "ssm_content"
          target => "[temp_ssm]"
          field_split => ", "
          value_split => " = "
          remove_char_key => "\""
          remove_char_value => "\""
        }

        if "_kvparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-ssm-kv"
            }
          }
        }

        mutate {
          id => "2001-c2imera-java-ssm-renames"
          rename => {
            "[temp_ssm][EMAIL_FROM]"                => "[email][from][address]"
            "[temp_ssm][PLATFORM]"                  => "[service][environment]"
            "[temp_ssm][FILE_UPLOAD_DIRECTORY]"     => "[file][directory]"
            "[temp_ssm][FILE_UPLOAD_SIZE_LIMIT]"    => "[file][size]"
            "[temp_ssm][DB_DIALECT]"                => "[c2imera][ssm][db][dialect]"
            "[temp_ssm][DB_DRIVER]"                 => "[c2imera][ssm][db][driver]"
            "[temp_ssm][DB_PASSWORD]"               => "[c2imera][ssm][db][password]"
            "[temp_ssm][DB_FILEPASSWORD]"           => "[c2imera][ssm][db][file_password]"
            "[temp_ssm][DB_BACKUP_DELAY_MINUTES]"   => "[c2imera][ssm][db][backup][delay_minutes]"
            "[temp_ssm][DB_BACKUP_START_TIME_MINUTE]" => "[c2imera][ssm][db][backup][start_minute]"
            "[temp_ssm][DB_BACKUP_START_TIME_HOUR]" => "[c2imera][ssm][db][backup][start_hour]"
            "[temp_ssm][DB_BACKUP_ENABLE]"          => "[c2imera][ssm][db][backup][enable]"
            "[temp_ssm][SYNC_ROLE]"                 => "[c2imera][ssm][sync][role]"
            "[temp_ssm][SYNC_ADDRESS]"              => "[c2imera][ssm][sync][address]"
            "[temp_ssm][SYNC_USERNAME]"             => "[c2imera][ssm][sync][username]"
            "[temp_ssm][SYNC_PASSWORD]"             => "[c2imera][ssm][sync][password]"
            "[temp_ssm][SYNC_ID_PREFIX]"            => "[c2imera][ssm][sync][id_prefix]"
            "[temp_ssm][KmeKA_BOOTSTRAP_SERVERS]"   => "[c2imera][ssm][kmeka][bootstrap_servers]"
            "[temp_ssm][KmeKA_USERNAME]"            => "[c2imera][ssm][kmeka][username]"
            "[temp_ssm][KmeKA_PASSWORD]"            => "[c2imera][ssm][kmeka][password]"
            "[temp_ssm][KmeKA_CACHE_DB_PASSWORD]"   => "[c2imera][ssm][kmeka][cache_db_password]"
            "[temp_ssm][EMAIL_SMS]"                 => "[c2imera][ssm][email][sms]"
            "[temp_ssm][CRITICAL_CONTACT]"          => "[c2imera][ssm][contact][critical]"
            "[temp_ssm][NORMAL_CONTACT]"            => "[c2imera][ssm][contact][normal]"
            "[temp_ssm][IMPROVEMENTS_CONTACT]"      => "[c2imera][ssm][contact][improvements]"
            "[temp_ssm][DEFAULT_ADMIN_USERNAME]"    => "[c2imera][ssm][admin][default_username]"
            "[temp_ssm][DEFAULT_ADMIN_EDIPI]"       => "[c2imera][ssm][admin][default_edipi]"
            "[temp_ssm][CROSS_DOMAIN_USERNAME]"     => "[c2imera][ssm][cross_domain][username]"
            "[temp_ssm][CROSS_DOMAIN_PASSWORD]"     => "[c2imera][ssm][cross_domain][password]"
            "[temp_ssm][REACT_BETA]"                => "[c2imera][ssm][react][beta]"
            "[temp_ssm][REACT_BETA_CANDIDATES]"     => "[c2imera][ssm][react][beta_candidates]"
            "[temp_ssm][CLASSIFICATION_LEVEL]"      => "[c2imera][ssm][classification_level]"
            "[temp_ssm][DATA_DIRECTORY]"            => "[c2imera][ssm][data_directory]"
            "[temp_ssm][COMMUNICATION_BANNER]"      => "[c2imera][ssm][communication_banner]"
            "[temp_ssm][OPENAPI_THROTTLE_comLIS]"   => "[c2imera][ssm][openapi][throttle_comlis]"
            "[temp_ssm][MONOLITH_LOGIN_RATE_LIMIT]" => "[c2imera][ssm][monolith][login_rate_limit]"
          }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-ssm-renames"
            }
          }
        }
      }
      else if [ssm_action] == "Reload starting" {
        mutate {
          id => "2001-c2imera-java-ssm-reload-split"
          split => { "ssm_content" => ", " }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-ssm-reload-split"
            }
          }
        }
        mutate {
          id => "2001-c2imera-java-ssm-reload-rename"
          rename => { "ssm_content" => "[c2imera][ssm][reloaded_parameters]" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-ssm-reload-rename"
            }
          }
        }
      }
    }

    # Topic 2: util.Auditor
    else if [log][logger] == "util.Auditor" {
      if [app_message] =~ /^AUDIT: HEADER =/ {
        grok {
          id => "2001-c2imera-java-auditor-header-grok"
          match => { "app_message" => "AUDIT: HEADER = %{DATA:header_key}: %{GREEDYDATA:header_value}" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-auditor-header-grok"
            }
          }
        }

        if [header_key] == "User-Agent" {
          mutate {
            id => "2001-c2imera-java-auditor-useragent-rename"
            rename => { "header_value" => "[user_agent][original]" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-useragent-rename"
              }
            }
          }
          useragent {
            id => "2001-c2imera-java-auditor-useragent-parse"
            source => "[user_agent][original]"
            target => "user_agent"
            ecs_compatibility => "v8"
          }
        }
        else if [header_key] == "Referer" {
          mutate {
            id => "2001-c2imera-java-auditor-referer-rename"
            rename => { "header_value" => "[http][request][referrer]" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-referer-rename"
              }
            }
          }
        }
        else {
          mutate {
            id => "2001-c2imera-java-auditor-header-add"
            add_field => { "[http][request][headers][%{header_key}]" => "%{header_value}" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-header-add"
              }
            }
          }
        }

        mutate {
          id => "2001-c2imera-java-auditor-header-cleanup"
          remove_field => ["header_key", "header_value"]
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-auditor-header-cleanup"
            }
          }
        }
      }
      else if [app_message] =~ /^AUDIT: username =/ {
        grok {
          id => "2001-c2imera-java-auditor-username-grok"
          match => { "app_message" => "AUDIT: username = %{DATA:[user][name]}\.\s+%{GREEDYDATA:[event][action]}" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-auditor-username-grok"
            }
          }
        }

        if [event][action] =~ /^(SUCCESS|FAILURE),/ {
          grok {
            id => "2001-c2imera-java-auditor-outcome-grok"
            match => { "[event][action]" => "%{WORD:[event][outcome]},\s+%{GREEDYDATA:[event][reason]}" }
          }

          if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-outcome-grok"
              }
            }
          }
          mutate {
            id => "2001-c2imera-java-auditor-outcome-mutate"
            lowercase => [ "[event][outcome]" ]
            replace => { "[event][action]" => "audit-check" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-outcome-mutate"
              }
            }
          }
        }
        else if [event][action] =~ /^PII:/ {
          grok {
            id => "2001-c2imera-java-auditor-pii-grok"
            match => { "[event][action]" => "PII:\s+%{GREEDYDATA:[event][reason]}" }
          }

          if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-pii-grok"
              }
            }
          }
          mutate {
            id => "2001-c2imera-java-auditor-pii-mutate"
            replace => { "[event][action]" => "pii-access" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-auditor-pii-mutate"
              }
            }
          }
        }
      }
    }

    # Topic 3: restauth.CertStoreJwsFunction
    else if [log][logger] == "restauth.CertStoreJwsFunction" {
      if [app_message] =~ /^Using trusted user:RestUser/ {
        grok {
          id => "2001-c2imera-java-certstorejws-grok"
          match => { "app_message" => "Using trusted user:RestUser%{DATA:user_info} roles:" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-certstorejws-grok"
            }
          }
        }
      }
    }

    # Topic 4: rest.OperationIdFilter
    else if [log][logger] == "rest.OperationIdFilter" {
      if [app_message] =~ /^Request path/ {
        mutate {
          id => "2001-c2imera-java-opfilter-copy"
          copy => { "[app_message]" => "[event][reason]" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-opfilter-copy"
            }
          }
        }
        grok {
          id => "2001-c2imera-java-opfilter-grok"
          match => { "app_message" => "Request path \"%{DATA:[url][path]}\" did not provide %{DATA:[c2imera][op_filter][missing_header]} header value" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-opfilter-grok"
            }
          }
        }
      }
    }

    # Topic 5: servlets.ServerClientSyncServlet
    else if [log][logger] == "servlets.ServerClientSyncServlet" {
      if [app_message] =~ /Ping received/ {
        grok {
          id => "2001-c2imera-java-sync-ping-grok"
          match => { "app_message" => "Ping received %{DATA:ping_json} code: %{INT:[c2imera][sync][response_code]}" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-sync-ping-grok"
            }
          }
        }

        if [ping_json] {
          ruby {
            id => "2001-c2imera-java-sync-ping-ruby"
            code => 'val = event.get("[ping_json]"); if val then event.set("[ping_json]", val.downcase) end'
          }

          if ("_rubyexception" in [tags] or "ruby_exception" in [tags]) and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-ping-ruby"
              }
            }
          }
        }

        json {
          id => "2001-c2imera-java-sync-ping-json"
          source => "ping_json"
          target => "[c2imera][sync][ping_data]"
        }

        if "_jsonparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-sync-ping-json"
            }
          }
        }

        mutate {
          id => "2001-c2imera-java-sync-ping-cleanup"
          remove_field => ["ping_json"]
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-sync-ping-cleanup"
            }
          }
        }
      }
      else {
        grok {
          id => "2001-c2imera-java-sync-grok"
          match => {
            "app_message" => [
              "^Activating sync for type: %{GREEDYDATA:[c2imera][sync][type]}(\s+)?$",
              "^Deactivating sync for type: %{GREEDYDATA:[c2imera][sync][type]}(\s+)?$",
              "^SYNC_PING_RATE: %{INT:[c2imera][sync][ping_rate]}(\s+)?$",
              "^SYNC_BATCH_SIZE: %{INT:[c2imera][sync][batch_size]}(\s+)?$",
              "^SYNC_PREFIX: %{DATA:[c2imera][sync][prefix]}(\s+)?$",
              "^SYNC_USERNAME: %{DATA:[c2imera][sync][username]}(\s+)?$",
              "^SYNC_ADDRESS: %{DATA:[c2imera][sync][address]}(\s+)?$",
              "^SYNC_ROLE: %{DATA:[c2imera][sync][role]}(\s+)?$",
              "^PING CONNECTION STATUS: %{DATA:[c2imera][sync][ping_connection_status]}(\s+)?$",
              "^REPORTER: %{DATA:[_temp][reporter]}: %{DATA:[_temp_reporter_status]}(\s+)?$",
              "^Sync url: %{DATA:[c2imera][sync][url]}(\s+)?$",
              "^isSyncTurnedOnFor: %{GREEDYDATA:[event][reason]}(\s+)?$",
              "^SYNC_HEARTBEAT: %{GREEDYDATA:[c2imera][sync][heartbeat_message]}(\s+)?$"
            ]
          }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-sync-grok"
            }
          }
        }

        if [_temp][reporter] {
          ruby {
            id => "2001-c2imera-java-sync-reporter-ruby"
            code => '
              reporter = event.get("[_temp][reporter]")
              status = event.get("[_temp_reporter_status]")
              if reporter && status
                reporter = reporter.gsub(/([a-z\d])([A-Z])/, "\\1_\\2")
                reporter = reporter.gsub(" ", "_").downcase
                field_path = "[c2imera][sync][reporter][#{reporter}]"
                event.set(field_path, status)
              end
            '
          }

          if ("_rubyexception" in [tags] or "ruby_exception" in [tags]) and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-reporter-ruby"
              }
            }
          }
          mutate {
            id => "2001-c2imera-java-sync-reporter-cleanup"
            remove_field => ["[_temp]", "[_temp_reporter_status]"]
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-reporter-cleanup"
              }
            }
          }
        }

        if [c2imera][sync][type] {
          mutate {
            id => "2001-c2imera-java-sync-type-strip"
            strip => ["[c2imera][sync][type]"]
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-type-strip"
              }
            }
          }
        }

        if [app_message] =~ /^Activating/ {
          mutate {
            id => "2001-c2imera-java-sync-activating"
            add_field => { "[event][action]" => "sync-activated" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-activating"
              }
            }
          }
        }
        else if [app_message] =~ /^Deactivating/ {
          mutate {
            id => "2001-c2imera-java-sync-deactivating"
            add_field => { "[event][action]" => "sync-deactivated" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-sync-deactivating"
              }
            }
          }
        }
      }
    }

    # Topic 6: sync.LastSyncTimeTool
    else if [log][logger] == "sync.LastSyncTimeTool" {
      if [app_message] =~ /^Loading last sync time/ {
        grok {
          id => "2001-c2imera-java-lastsync-grok"
          match => { "app_message" => "^Loading last sync time for type: %{DATA:[c2imera][sync][type]}(\s+)?$" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-lastsync-grok"
            }
          }
        }
        mutate {
          id => "2001-c2imera-java-lastsync-mutate"
          add_field => { "[event][action]" => "loading-last-sync-time" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-lastsync-mutate"
            }
          }
        }
      }
    }

    # Topic 7: query.Uc2QueryUtils
    else if [log][logger] == "query.Uc2QueryUtils" {
      if [app_message] =~ /^Querying by Last Updated/ {
        grok {
          id => "2001-c2imera-java-queryutils-grok"
          match => { "app_message" => "^Querying by Last Updated; %{DATA:[c2imera][query][method]}; Time: %{DATA:[c2imera][query][time_string]} Operator: %{DATA:[c2imera][query][operator]} Batch: %{INT:[c2imera][query][batch_size]} Offset: %{INT:[c2imera][query][offset]}$" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-queryutils-grok"
            }
          }
        }
        mutate {
          id => "2001-c2imera-java-queryutils-mutate"
          add_field => { "[event][action]" => "query-last-updated" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-queryutils-mutate"
            }
          }
        }
      }
    }

    # Topic 8: RequestTimer
    else if [log][logger] == "RequestTimer" {
      if [app_message] =~ /^Request/ {
        grok {
          id => "2001-c2imera-java-requesttimer-grok"
          match => {
            "app_message" => [
              # Pattern 1: Completed (Existing)
              "^Request %{WORD:[http][request][method]} \"%{DATA:[url][path]}\" completed in %{INT:[c2imera][request_timer][duration_ms]} ms\. Sent from %{DATA:[c2imera][request_timer][source_ips]}\s+\"%{DATA}\"",
              # Pattern 2: Started (New)
              "^Request %{WORD:[http][request][method]} \"%{DATA:[url][path]}\" started\. Sent from %{DATA:[c2imera][request_timer][source_ips]}\s+\"%{DATA}\""
            ]
          }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-requesttimer-grok"
            }
          }
        }

        # Set specific actions to distinguish start vs complete
        if [app_message] =~ / started\./ {
          mutate {
            id => "2001-c2imera-java-requesttimer-started"
            add_field => { "[event][action]" => "request-timer-started" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-requesttimer-started"
              }
            }
          }
        }
        else {
          mutate {
            id => "2001-c2imera-java-requesttimer-completed"
            add_field => { "[event][action]" => "request-timer-completed" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-requesttimer-completed"
              }
            }
          }
        }

        # Only convert duration if it exists (Started logs won't have it)
        if [c2imera][request_timer][duration_ms] {
          mutate {
            id => "2001-c2imera-java-requesttimer-convert"
            convert => { "[c2imera][request_timer][duration_ms]" => "integer" }
          }

          if "_mutate_error" in [tags] and ![error][source_plugin_id] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2001-c2imera-java.conf"
                "[error][source_plugin_id]" => "2001-c2imera-java-requesttimer-convert"
              }
            }
          }
        }
      }
    }

    # Topic 9: rest.DataObjectRestServiceWrapper
    else if [log][logger] == "rest.DataObjectRestServiceWrapper" {
      if [app_message] =~ /^getDataObjectsByDataObjectQuery/ {
        grok {
          id => "2001-c2imera-java-dataobject-grok"
          match => { "app_message" => "getDataObjectsByDataObjectQuery: DataObjectQuery with %{INT:[c2imera][data_object][filter_count]} Filters:%{GREEDYDATA:[c2imera][data_object][query]} \(SANITIZED\)" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-dataobject-grok"
            }
          }
        }
        mutate {
          id => "2001-c2imera-java-dataobject-mutate"
          add_field => { "[event][action]" => "data-object-query" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-dataobject-mutate"
            }
          }
        }
      }
    }

    # Topic 10: rest.SyncDeterminatorTool
    else if [log][logger] == "rest.SyncDeterminatorTool" {
      if [app_message] =~ /^SYNCDETERMINATORTOOL:/ {
        grok {
          id => "2001-c2imera-java-syncdeterminator-grok"
          match => { "app_message" => "SYNCDETERMINATORTOOL: %{GREEDYDATA:[c2imera][sync_determinator]}" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-syncdeterminator-grok"
            }
          }
        }
      }
      mutate {
        id => "2001-c2imera-java-syncdeterminator-strip"
        strip => ["[c2imera][sync_determinator]"]
      }

      if "_mutate_error" in [tags] and ![error][source_plugin_id] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2001-c2imera-java.conf"
            "[error][source_plugin_id]" => "2001-c2imera-java-syncdeterminator-strip"
          }
        }
      }
    }

    # Topic 11: internal.UserServiceInternal
    else if [log][logger] == "internal.UserServiceInternal" {
      if [app_message] =~ /^Adding user:/ {
        grok {
          id => "2001-c2imera-java-userservice-grok"
          match => { "app_message" => "Adding user: <%{DATA:[user][name]}>" }
        }

        if "_grokparsefailure" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-userservice-grok"
            }
          }
        }
        mutate {
          id => "2001-c2imera-java-userservice-mutate"
          add_field => { "[event][action]" => "user-added" }
        }

        if "_mutate_error" in [tags] and ![error][source_plugin_id] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2001-c2imera-java.conf"
              "[error][source_plugin_id]" => "2001-c2imera-java-userservice-mutate"
            }
          }
        }
      }
    }
  }
}
