filter {
  if [@metadata][log_lane] == "legacy_lane" {
    # 1. Generic Legacy Header
    grok {
      id => "2002-c2imera-legacy-header-grok"
      match => {
        "message" => [
          "^%{DATA:raw_ts}\s+%{LOGLEVEL:[log][level]}:\s+%{DATA:app_message} \(OID:%{DATA:[trace][id]}\)\s*\(TID:%{DATA:[process][thread][id]}\)\s*\[%{GREEDYDATA:legacy_class_info}\]$",
          "^%{DATA:raw_ts}\s+%{LOGLEVEL:[log][level]}:\s+%{DATA:app_message} \(OID:%{DATA:[trace][id]}\)\s*\[%{GREEDYDATA:legacy_class_info}\]$",
          "^%{DATA:raw_ts}\s+%{LOGLEVEL:[log][level]}:\s+%{DATA:app_message} \(OID:%{DATA:[trace][id]}\)$",
          "^%{DATA:raw_ts}\s+%{LOGLEVEL:[log][level]}:\s+%{GREEDYDATA:app_message}$"
        ]
      }
      tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-header-grok"]
    }

    if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-header-grok" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2002-c2imera-legacy.conf"
          "[error][source_plugin_id]" => "2002-c2imera-legacy-header-grok"
        }
      }
    }

    date {
      id => "2002-c2imera-legacy-date"
      match => [ "raw_ts", "yyyyMMddHHmmssSSS" ]
      target => "@timestamp"
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__2002-c2imera-legacy__date__2002-c2imera-legacy-date"]
    }

    if "_logstash_failure__2002-c2imera-legacy__date__2002-c2imera-legacy-date" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2002-c2imera-legacy.conf"
          "[error][source_plugin_id]" => "2002-c2imera-legacy-date"
        }
      }
    }

    # TOPIC 1: NODE (JSON Data)
    if [app_message] =~ /^NODE: \{/ {
      grok {
        id => "2002-c2imera-legacy-node-grok"
        match => { "app_message" => "NODE: %{DATA:node_json} \| %{GREEDYDATA:dce_data}" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-node-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-node-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-node-grok"
          }
        }
      }

      json {
        id => "2002-c2imera-legacy-node-json"
        source => "node_json"
        target => "[c2imera][node]"
        tag_on_failure => ["_jsonparsefailure", "_logstash_failure__2002-c2imera-legacy__json__2002-c2imera-legacy-node-json"]
      }

      if "_logstash_failure__2002-c2imera-legacy__json__2002-c2imera-legacy-node-json" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-node-json"
          }
        }
      }

      grok {
        id => "2002-c2imera-legacy-dce-grok"
        match => { "dce_data" => "DATACHANGEVENT: DataChangeEvent \[id=%{DATA:[c2imera][dce][id]}, workspaceName=%{DATA:[c2imera][workspace]}, createdAt=%{DATA:[c2imera][dce][created_at]}, type=%{DATA:[c2imera][dce][type]}, dataType=%{GREEDYDATA:[c2imera][dce][data_type]}\]" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dce-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dce-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-dce-grok"
          }
        }
      }

      if [c2imera][node] {
        ruby {
          id => "2002-c2imera-legacy-node-ruby"
          code => '
            def to_snake(str); str.gsub(/([a-z\d])([A-Z])/, "\\1_\\2").downcase; end
            def process_hash(h)
              new_h = {}
              h.each do |k, v|
                new_k = to_snake(k)
                if v.is_a?(Hash) then new_h[new_k] = process_hash(v) else new_h[new_k] = v end
              end
              new_h
            end
            node_data = event.get("[c2imera][node]")
            if node_data.is_a?(Hash) then new_data = process_hash(node_data); event.set("[c2imera][node]", new_data) end
          '
          tag_on_exception => "_logstash_failure__2002-c2imera-legacy__ruby__2002-c2imera-legacy-node-ruby"
        }

        if ("_logstash_failure__2002-c2imera-legacy__ruby__2002-c2imera-legacy-node-ruby" in [tags] or "ruby_exception" in [tags] or "_rubyexception" in [tags]) {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-node-ruby"
            }
            add_tag => ["_logstash_failure__2002-c2imera-legacy__ruby__2002-c2imera-legacy-node-ruby", "_logstash_attributed_ruby_exception"]
            remove_tag => ["ruby_exception", "_rubyexception"]
          }
        }
      }

      mutate {
        id => "2002-c2imera-legacy-node-mutate"
        add_field => { "[event][action]" => "node-data-change" }
        remove_field => ["node_json", "dce_data"]
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-node-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-node-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    # TOPIC 2: User Filters
    else if [app_message] =~ /^createFilterForUser/ {
      grok {
        id => "2002-c2imera-legacy-userfilter-grok"
        match => { "app_message" => "createFilterForUser for user \"%{DATA:[user][name]}\" and workspace \"%{DATA:[c2imera][workspace]}\" finished in %{INT:[c2imera][user_filter][duration_ms]} ms" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-userfilter-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-userfilter-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-userfilter-grok"
          }
        }
      }
      mutate {
        id => "2002-c2imera-legacy-userfilter-mutate"
        add_field => { "[event][action]" => "create-filter-for-user" }
        convert => { "[c2imera][user_filter][duration_ms]" => "integer" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-userfilter-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-userfilter-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    # TOPIC 3: Scheduled Jobs
    else if [app_message] =~ /^Scheduling job/ {
      grok {
        id => "2002-c2imera-legacy-scheduledjob-grok"
        match => { "app_message" => "Scheduling job ScheduledJob\{jobId=%{INT:[c2imera][scheduled_job][id]}, jobType='%{DATA:[c2imera][job][type]}', targetObjectId=%{DATA:[c2imera][job][target_id]}, secondaryId='%{DATA:[c2imera][job][secondary_id]}', scheduledTime=%{DATA:[c2imera][job][scheduled_time]}\}" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-scheduledjob-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-scheduledjob-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-scheduledjob-grok"
          }
        }
      }
      mutate {
        id => "2002-c2imera-legacy-scheduledjob-mutate"
        add_field => { "[event][action]" => "schedule-job" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-scheduledjob-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-scheduledjob-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    # TOPIC 4: Security Context
    else if [app_message] =~ /^filter\(\)/ {
      grok {
        id => "2002-c2imera-legacy-secctx-filter-grok"
        match => { "app_message" => "filter\(\) %{DATA:[url][full]} resolved to: DefaultSecurityContext\[user:RestUser\{%{DATA:user_info}\}, roles:\[%{DATA:[user][roles]}\]\]" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-secctx-filter-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-secctx-filter-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-secctx-filter-grok"
          }
        }
      }
      mutate {
        id => "2002-c2imera-legacy-secctx-filter-mutate"
        add_field => { "[event][action]" => "security-context-resolved" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-secctx-filter-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-secctx-filter-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    else if [app_message] =~ /^Using trusted user:/ {
      grok {
        id => "2002-c2imera-legacy-secctx-trusted-grok"
        match => { "app_message" => "Using trusted user:RestUser\{%{DATA:user_info}\} roles:\[%{DATA:[user][roles]}\]\]?" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-secctx-trusted-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-secctx-trusted-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-secctx-trusted-grok"
          }
        }
      }
      mutate {
        id => "2002-c2imera-legacy-secctx-trusted-mutate"
        add_field => { "[event][action]" => "security-context-created" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-secctx-trusted-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-secctx-trusted-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    # TOPIC 5: EDIT DCE Received
    else if [app_message] =~ /^EDIT DCE received/ {
      grok {
        id => "2002-c2imera-legacy-dce-received-grok"
        match => { "app_message" => "EDIT DCE received\. Content Type: \"%{DATA:[c2imera][dce][content_type]}\", Kmeka Msg Key: %{GREEDYDATA:[c2imera][dce][msg_key]}" }
        tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dce-received-grok"]
      }

      if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dce-received-grok" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-dce-received-grok"
          }
        }
      }
      mutate {
        id => "2002-c2imera-legacy-dce-received-mutate"
        add_field => { "[event][action]" => "dce-received" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-dce-received-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-dce-received-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }

    # TOPIC 6: Warnings & Errors
    else if [log][level] in ["WARNING", "ERROR"] or [app_message] =~ /^Error -/ {
      mutate {
        id => "2002-c2imera-legacy-error-copy"
        copy => { "[app_message]" => "[event][reason]" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-error-copy"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-error-copy", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }

      if [app_message] =~ /No DataObject found on/ {
        grok {
          id => "2002-c2imera-legacy-dataobject-missing-grok"
          match => { "app_message" => "No DataObject found on %{DATA:[c2imera][data_object][id]};" }
          tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dataobject-missing-grok"]
        }

        if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-dataobject-missing-grok" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-dataobject-missing-grok"
            }
          }
        }
        mutate {
          id => "2002-c2imera-legacy-dataobject-missing-mutate"
          add_field => { "[event][action]" => "data-object-missing" }
        }

        if "_mutate_error" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-dataobject-missing-mutate"
            }
            add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-dataobject-missing-mutate", "_logstash_attributed_mutate_error"]
            remove_tag => ["_mutate_error"]
          }
        }
      }
      else if [app_message] =~ /^Error -/ {
        grok {
          id => "2002-c2imera-legacy-apperror-grok"
          match => { "app_message" => "Error - %{DATA:[event][reason]} \(ID:%{DATA:[error][id]}\)" }
          overwrite => [ "[event][reason]" ]
          tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-apperror-grok"]
        }

        if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-apperror-grok" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-apperror-grok"
            }
          }
        }
        mutate {
          id => "2002-c2imera-legacy-apperror-mutate"
          add_field => { "[event][action]" => "application-error" }
        }

        if "_mutate_error" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-apperror-mutate"
            }
            add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-apperror-mutate", "_logstash_attributed_mutate_error"]
            remove_tag => ["_mutate_error"]
          }
        }
      }
    }

    # TOPIC 7: Scribe Processor
    else if [app_message] =~ /^Using normal scribe processor/ {
      mutate {
        id => "2002-c2imera-legacy-scribe-mutate"
        add_field => { "[event][action]" => "scribe-processor-status" }
        copy => { "[app_message]" => "[event][reason]" }
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2002-c2imera-legacy.conf"
            "[error][source_plugin_id]" => "2002-c2imera-legacy-scribe-mutate"
          }
          add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-scribe-mutate", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }

      if [legacy_class_info] {
        grok {
          id => "2002-c2imera-legacy-scribe-grok"
          match => { "legacy_class_info" => "%{JAVACLASS:[log][logger]} %{DATA:[log][origin][function]}" }
          tag_on_failure => ["_grokparsefailure", "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-scribe-grok"]
        }

        if "_logstash_failure__2002-c2imera-legacy__grok__2002-c2imera-legacy-scribe-grok" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2002-c2imera-legacy.conf"
              "[error][source_plugin_id]" => "2002-c2imera-legacy-scribe-grok"
            }
          }
        }
      }
    }

    # Cleanup Legacy Details
    mutate {
      id => "2002-c2imera-legacy-cleanup"
      remove_field => ["legacy_class_info"]
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2002-c2imera-legacy.conf"
          "[error][source_plugin_id]" => "2002-c2imera-legacy-cleanup"
        }
        add_tag => ["_logstash_failure__2002-c2imera-legacy__mutate__2002-c2imera-legacy-cleanup", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }
}
