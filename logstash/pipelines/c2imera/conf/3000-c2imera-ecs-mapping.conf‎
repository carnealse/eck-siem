filter {
  if [@metadata][log_lane] in ["java_lane", "legacy_lane"] {
    mutate {
      id => "3000-c2imera-ecs-mapping-mutate-01"
      add_field => {
        "[event][kind]"    => "event"
        "[event][dataset]" => "c2imera"
      }
    }

    if "_mutate_error" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "3000-c2imera-ecs-mapping.conf"
          }
        }
      }

      if [error][source_plugin_id] {
        mutate {
          update => {
            "[error][source_plugin_id]" => "%{[error][source_plugin_id]} | 3000-c2imera-ecs-mapping-mutate-01"
          }
        add_tag => ["_logstash_failure__3000-c2imera-ecs-mapping__mutate__3000-c2imera-ecs-mapping-mutate-01", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
        }
      } else {
        mutate {
          add_field => {
            "[error][source_plugin_id]" => "3000-c2imera-ecs-mapping-mutate-01"
          }
        add_tag => ["_logstash_failure__3000-c2imera-ecs-mapping__mutate__3000-c2imera-ecs-mapping-mutate-01", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
        }
      }
    }
  }
}
