filter {
  if [@metadata][log_lane] in ["java_lane", "legacy_lane"] {
    mutate {
      id => "3000-c2imera-ecs-mapping"
      add_field => {
        "[event][kind]"    => "event"
        "[event][dataset]" => "c2imera"
      }
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "3000-c2imera-ecs-mapping.conf"
          "[error][source_plugin_id]" => "3000-c2imera-ecs-mapping"
        }
        add_tag => ["_logstash_failure__3000-c2imera-ecs-mapping__mutate__3000-c2imera-ecs-mapping", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }
}
