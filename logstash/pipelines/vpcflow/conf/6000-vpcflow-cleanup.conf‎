filter {
  fingerprint {
    source => [ "[event][original]" ]
    method => "SHA256"
    target => "[@metadata][fingerprint]"
    id => "6000-vpcflow-final-fingerprint"
  }

  mutate {
    remove_field => [ "[_temp]", "[aws][vpcflow][srcaddr]", "[aws][vpcflow][srcport]", "[aws][vpcflow][dstaddr]", "[aws][vpcflow][dstport]", "[aws][vpcflow][bytes]", "[aws][vpcflow][packets]", "[aws][vpcflow][protocol]"]
    id => "6000-vpcflow-cleanup"
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-vpcflow-cleanup.conf"
        "[error][source_plugin_id]" => "6000-vpcflow-cleanup"
      }
      add_tag => ["_logstash_failure__6000-vpcflow-cleanup__mutate__6000-vpcflow-cleanup", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # Do not set data_stream_namespace here; that will be handled in the return pipeline
  mutate {
    add_field => {
      "data_stream_dataset" => "aws.vpcflow"
    }
    id => "6000-vpcflow-dataset-tag"
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-vpcflow-cleanup.conf"
        "[error][source_plugin_id]" => "6000-vpcflow-dataset-tag"
      }
      add_tag => ["_logstash_failure__6000-vpcflow-cleanup__mutate__6000-vpcflow-dataset-tag", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
}
