filter {
  fingerprint {
    source => [ "[event][original]" ]
    method => "SHA256"
    target => "[@metadata][fingerprint]"
    id => "6000-vpcflow-final-fingerprint"
  }

  mutate {
    remove_field => [ "[_temp]", "[aws][vpcflow][srcaddr]", "[aws][vpcflow][srcport]", "[aws][vpcflow][dstaddr]", "[aws][vpcflow][dstport]", "[aws][vpcflow][bytes]", "[aws][vpcflow][packets]", "[aws][vpcflow][protocol]"]
    id => "6000-vpcflow-cleanup-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-vpcflow-cleanup-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # Do not set data_stream_namespace here; that will be handled in the return pipeline
  mutate {
    add_field => {
      "data_stream_dataset" => "aws.vpcflow"
    }
    id => "6000-vpcflow-dataset-tag-mutate-02"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-vpcflow-dataset-tag-mutate-02"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }


  # required to check the [error][source_config] array as LS evaluation has limitations with arrays
  ruby {
    id => "6000-vpcflow-cleanup-source-config-fallback"
    code => '
      plugin_ids = event.get("[error][source_plugin_id]")
      if plugin_ids
        ids_array = plugin_ids.is_a?(Array) ? plugin_ids : [plugin_ids]
        has_match = ids_array.any? { |id| id.to_s.start_with?("6000-vpcflow") }
        if has_match
          configs = event.get("[error][source_config]")
          configs_array = configs.nil? ? [] : (configs.is_a?(Array) ? configs : [configs])
          unless configs_array.include?("6000-vpcflow-cleanup.conf")
            event.set("[_temp][config_boolean]", "true")
          end
        end
      end
    '
  }

  if [_temp][config_boolean] == "true" {
    mutate {
      add_field => {
        "[error][source_config]" => "6000-vpcflow-cleanup.conf"
      }
      remove_field => ["[_temp]"]
    }
  }
}
