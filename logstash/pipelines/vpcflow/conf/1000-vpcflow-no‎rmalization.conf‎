filter {
  mutate {
    add_tag => ["logstash", "version_2"]
    id => "1000-vpcflow-initial-tags-mutate-01"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-vpcflow-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-vpcflow-initial-tags-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
      add_field => { "[ecs][version]" => "8.0.0" }
      id => "1000-vpcflow-ecs-version-mutate-02"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-vpcflow-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-vpcflow-ecs-version-mutate-02"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
      rename => { "message" => "[event][original]" }
      id => "1000-vpcflow-preserve-original-mutate-03"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-vpcflow-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-vpcflow-preserve-original-mutate-03"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
      add_field => { "[event][type]" => "connection" }
      id => "1000-vpcflow-event-type-mutate-04"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-vpcflow-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-vpcflow-event-type-mutate-04"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
      add_field => { "[event][category]" => "network" }
      id => "1000-vpcflow-event-category-mutate-05"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-vpcflow-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-vpcflow-event-category-mutate-05"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  if [event][original] =~ "version" or [event][original] =~ "instance-id" {
      drop { id => "1000-vpcflow-drop-headers" }
  }

  if [event][original] =~ /^\[/ {
    mutate {
      gsub => [
        "[event][original]", "^\[", "",
        "[event][original]", "\]$", ""
      ]
      id => "1000-vpcflow-strip-brackets-mutate-06"
    }

    if "_mutate_error" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "1000-vpcflow-normalization.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-vpcflow-strip-brackets-mutate-06"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
    if [event][original] =~ /, / {
      mutate { 
        split => { "[event][original]" => ", " } 
        id => "1000-vpcflow-split-comma-mutate-07"
      }

      if "_mutate_error" in [tags] {
        if ![error][source_config] {
          mutate {
            add_field => {
              "[error][source_config]" => "1000-vpcflow-normalization.conf"
            }
          }
        }

        mutate {
          add_field => {
            "[error][source_plugin_id]" => "1000-vpcflow-split-comma-mutate-07"
          }
          add_tag => ["_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
      split { 
        field => "[event][original]" 
        id => "1000-vpcflow-split-field"
      }
    }
    mutate {
      add_tag => ["split_message"]
      id => "1000-vpcflow-tag-split-mutate-08"
    }

    if "_mutate_error" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "1000-vpcflow-normalization.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-vpcflow-tag-split-mutate-08"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }
}
