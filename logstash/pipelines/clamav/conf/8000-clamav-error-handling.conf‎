filter {
  # Restore generic failure tags after per-plugin attribution removes them to avoid false matches.

  if "_logstash_attributed_aggregate_exception" in [tags] and !("_aggregateexception" in [tags]) {
    mutate {
      id => "8000-restore-aggregate-exception-tag"
      add_tag => ["_aggregateexception"]
      remove_tag => ["_logstash_attributed_aggregate_exception"]
    }
  }

  if "_logstash_attributed_csv_parse_failure" in [tags] and !("_csvparsefailure" in [tags]) {
    mutate {
      id => "8000-restore-csv-parse-failure-tag"
      add_tag => ["_csvparsefailure"]
      remove_tag => ["_logstash_attributed_csv_parse_failure"]
    }
  }

  if "_logstash_attributed_date_parse_failure" in [tags] and !("_dateparsefailure" in [tags]) {
    mutate {
      id => "8000-restore-date-parse-failure-tag"
      add_tag => ["_dateparsefailure"]
      remove_tag => ["_logstash_attributed_date_parse_failure"]
    }
  }

  if "_logstash_attributed_dissect_failure" in [tags] and !("_dissectfailure" in [tags]) {
    mutate {
      id => "8000-restore-dissect-failure-tag"
      add_tag => ["_dissectfailure"]
      remove_tag => ["_logstash_attributed_dissect_failure"]
    }
  }

  if "_logstash_attributed_geoip_lookup_failure" in [tags] and !("_geoip_lookup_failure" in [tags]) {
    mutate {
      id => "8000-restore-geoip-lookup-failure-tag"
      add_tag => ["_geoip_lookup_failure"]
      remove_tag => ["_logstash_attributed_geoip_lookup_failure"]
    }
  }

  if "_logstash_attributed_grok_parse_failure" in [tags] and !("_grokparsefailure" in [tags]) {
    mutate {
      id => "8000-restore-grok-parse-failure-tag"
      add_tag => ["_grokparsefailure"]
      remove_tag => ["_logstash_attributed_grok_parse_failure"]
    }
  }

  if "_logstash_attributed_kv_parse_failure" in [tags] and !("_grok_kv_parse_failure" in [tags]) {
    mutate {
      id => "8000-restore-kv-parse-failure-tag"
      add_tag => ["_grok_kv_parse_failure"]
      remove_tag => ["_logstash_attributed_kv_parse_failure"]
    }
  }

  if "_logstash_attributed_json_parse_failure" in [tags] and !("_jsonparsefailure" in [tags]) {
    mutate {
      id => "8000-restore-json-parse-failure-tag"
      add_tag => ["_jsonparsefailure"]
      remove_tag => ["_logstash_attributed_json_parse_failure"]
    }
  }

  if "_logstash_attributed_mutate_error" in [tags] and !("_mutate_error" in [tags]) {
    mutate {
      id => "8000-clamav-restore-mutate-error-tag"
      add_tag => ["_mutate_error"]
      remove_tag => ["_logstash_attributed_mutate_error"]
    }
  }

  if "_logstash_attributed_ruby_exception" in [tags] and !("_rubyexception" in [tags]) {
    mutate {
      id => "8000-clamav-restore-ruby-exception-tags"
      add_tag => ["_rubyexception", "ruby_exception"]
      remove_tag => ["_logstash_attributed_ruby_exception"]
    }
  }

  if "_logstash_attributed_xml_parse_failure" in [tags] and !("_xmlparsefailure" in [tags]) {
    mutate {
      id => "8000-restore-xml-parse-failure-tag"
      add_tag => ["_xmlparsefailure"]
      remove_tag => ["_logstash_attributed_xml_parse_failure"]
    }
  }

  ###########################
  # Finalize Error Handling #
  ###########################

  if "_aggregateexception" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-aggregate-exception-add"
        add_field => { "[error][message]" => "aggregate exception occurred" }
      }
    } else {
      mutate {
        id => "8000-clamav-aggregate-exception-update"
        update => { "[error][message]" => "%{[error][message]} | aggregate exception occurred" }
      }
    }
  }

  if "_csvparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-csv-parse-failure-add"
        add_field => { "[error][message]" => "csv parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-csv-parse-failure-update"
        update => { "[error][message]" => "%{[error][message]} | csv parsing failed" }
      }
    }
  }

  if "_dateparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-dateparsefailure-add"
        add_field => { "[error][message]" => "date parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-dateparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | date parsing failed" }
      }
    }
  }

  if "_dissectfailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-dissectfailure-add"
        add_field => { "[error][message]" => "dissect parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-dissectfailure-update"
        update => { "[error][message]" => "%{[error][message]} | dissect parsing failed" }
      }
    }
  }

  if "_geoip_lookup_failure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-geoip-lookup-failure-add"
        add_field => { "[error][message]" => "geoip lookup failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-geoip-lookup-failure-update"
        update => { "[error][message]" => "%{[error][message]} | geoip lookup failed" }
      }
    }
  }

  if "_grokparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-grokparsefailure-add"
        add_field => { "[error][message]" => "grok parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-grokparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | grok parsing failed" }
      }
    }
  }

  if "_grok_kv_parse_failure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-grok-kv-parse-failure-add"
        add_field => { "[error][message]" => "grok kv parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-grok-kv-parse-failure-update"
        update => { "[error][message]" => "%{[error][message]} | grok kv parsing failed" }
      }
    }
  }

  if "_jsonparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-jsonparsefailure-add"
        add_field => { "[error][message]" => "json parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-jsonparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | json parsing failed" }
      }
    }
  }

  if "_kvparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-kvparsefailure-add"
        add_field => { "[error][message]" => "kv parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-kvparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | kv parsing failed" }
      }
    }
  }

  if "_mutate_error" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-mutate-error-add"
        add_field => { "[error][message]" => "mutate error occurred" }
      }
    } else {
      mutate {
        id => "8000-clamav-mutate-error-update"
        update => { "[error][message]" => "%{[error][message]} | mutate error occurred" }
      }
    }
  }

  if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-rubyexception-add"
        add_field => { "[error][message]" => "An exception occurred in the ruby code" }
      }
    } else {
      mutate {
        id => "8000-clamav-rubyexception-update"
        update => { "[error][message]" => "%{[error][message]} | An exception occurred in the ruby code" }
      }
    }
  }

  if "_xmlparsefailure" in [tags] {
    if ![error][message] {
      mutate {
        id => "8000-clamav-xmlparsefailure-add"
        add_field => { "[error][message]" => "xml parsing failed" }
      }
    } else {
      mutate {
        id => "8000-clamav-xmlparsefailure-update"
        update => { "[error][message]" => "%{[error][message]} | xml parsing failed" }
      }
    }
  }

  # count the number of plugin_ids and set the event status
  if [error][source_plugin_id] {
    ruby {
      id   => "8000-clamav-pipeline-error-count"
      code => '
        source = event.get("[error][source_plugin_id]")
        err_count = source.is_a?(Array) ? source.length : (source.nil? ? 0 : 1)

        if err_count == 1
          event.set("[error][event_status]", "1 processing failure")
        else
          event.set("[error][event_status]", "#{err_count} processing failures")
        end
      '
    }
  }

  # Consolidate all filter errors under one tag and stamp pipeline metadata
  if [error][source_plugin_id] {
    mutate {
      id => "8000-clamav-pipeline-error-consolidation"
      add_tag => ["pipeline_processing_error"]
      replace => {
        "[error][source_pipeline]" => "clamav"
      }
    }
  }

  # Fallback generic error message if none was set
  if "pipeline_processing_error" in [tags] and ![error][message] {
    mutate {
      id => "8000-clamav-generic-error-message"
      add_field => { "[error][message]" => "clamav generic pipeline processing failure" }
    }
  }
}

