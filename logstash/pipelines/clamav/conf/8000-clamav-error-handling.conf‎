filter {
  if "_jsonparsefailure" in [tags] {
    mutate {
      add_tag => ["_jsonparsefailure"]
      add_field => { "[error][message]" => "error parsing json" }
    }
  }

  if "_rubyexception" in [tags] {
    mutate {
      add_tag => ["_rubyexception"]
      add_field => { "[error][message]" => "error in ruby code" }
    }
  }
}
