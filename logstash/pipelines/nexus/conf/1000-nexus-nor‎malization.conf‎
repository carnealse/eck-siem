filter {
  # This is broken into three message types: main nexus, service, and healthchecker messages.
  # Healthchecker is captured as is and is not broken into fields.
  mutate {
    add_field => {
      "[event][original]" => "%{[message]}"
    }
    id => "1000-nexus-preserve-original-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-nexus-preserve-original-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # check message type (json or not) and add a temp field that will be used for conditionals later on
  if [message] =~ /^(\s+)?\{.*\}(\s+)?$/ {
    mutate {
      add_field => { "isJson" => "true" }
      id => "1000-nexus-detect-json-mutate-02"
    }

    if "_mutate_error" in [tags] {

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-nexus-detect-json-mutate-02"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  } else if !([message] =~ /^\{.*\}$/) {
    mutate {
      add_field => { "isJson" => "false" }
      id => "1000-nexus-detect-non-json-mutate-03"
    }

    if "_mutate_error" in [tags] {

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-nexus-detect-non-json-mutate-03"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }

  mutate {
    id => "1000-nexus-update-tags-mutate-04"
    replace => {
      "tags" => ["logstash"]
    }
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-nexus-update-tags-mutate-04"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }


  # required to check the [error][source_config] array as LS evaluation has limitations with arrays
  ruby {
    id => "1000-nexus-normalization-source-config-fallback"
    code => '
      plugin_ids = event.get("[error][source_plugin_id]")
      if plugin_ids
        ids_array = plugin_ids.is_a?(Array) ? plugin_ids : [plugin_ids]
        has_match = ids_array.any? { |id| id.to_s.start_with?("1000-nexus") }
        if has_match
          configs = event.get("[error][source_config]")
          configs_array = configs.nil? ? [] : (configs.is_a?(Array) ? configs : [configs])
          unless configs_array.include?("1000-nexus-normalization.conf")
            event.set("[_temp][config_boolean]", "true")
          end
        end
      end
    '
  }

  # paired with the ruby above to append the [error][source_config] and not just replace exisiting values
  if [_temp][config_boolean] == "true" {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-nexus-normalization.conf"
      }
      remove_field => ["[_temp]"]
    }
  }
}
