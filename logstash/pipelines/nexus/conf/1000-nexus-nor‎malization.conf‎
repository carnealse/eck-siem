filter {
  # This is broken into three message types: main nexus, service, and healthchecker messages.
  # Healthchecker is captured as is and is not broken into fields.
  mutate {
    add_field => {
      "[event][original]" => "%{[message]}"
    }
    id => "1000-nexus-preserve-original-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-nexus-preserve-original-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # check message type (json or not) and add a temp field that will be used for conditionals later on
  if [message] =~ /^(\s+)?\{.*\}(\s+)?$/ {
    mutate {
      add_field => { "isJson" => "true" }
      id => "1000-nexus-detect-json-mutate-02"
    }

    if "_mutate_error" in [tags] {

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-nexus-detect-json-mutate-02"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  } else if !([message] =~ /^\{.*\}$/) {
    mutate {
      add_field => { "isJson" => "false" }
      id => "1000-nexus-detect-non-json-mutate-03"
    }

    if "_mutate_error" in [tags] {

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-nexus-detect-non-json-mutate-03"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }

  mutate {
    id => "1000-nexus-update-tags-mutate-04"
    replace => {
      "tags" => ["logstash"]
    }
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-nexus-update-tags-mutate-04"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-nexus-normalization.conf"
      }
    }
  }
}
