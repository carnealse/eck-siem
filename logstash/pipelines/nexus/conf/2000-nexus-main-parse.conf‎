filter {
  ### START JSON ONLY PROCESSING ###
  if [isJson] == "true" {

    # process the json
    json {
      id => "2000-nexus-json_process-json-01"
      source => "message"
      tag_on_failure => ["_jsonparsefailure", "_logstash_failure__2000-nexus-main-parse__json__2000-nexus-json_process-json-01"]
    }

    if "_logstash_failure__2000-nexus-main-parse__json__2000-nexus-json_process-json-01" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2000-nexus-main-parse.conf"
          "[error][source_plugin_id]" => "2000-nexus-json_process-json-01"
        }
      }
    }

    # initial renames to ECS
    mutate {
      id => "2000-nexus-initial_renames-mutate-01"
      rename => {
        "[context]"                              => "[nexus][context]"
        "[domain]"                               => "[nexus][domain]"
        "[initiator]"                            => "[nexus][initiator]"
        "[nodeId]"                               => "[nexus][node][id]"
        "[thread]"                               => "[process][thread][name]"
        "[type]"                                 => "[event][action]"
        "[attributes][.created]"                 => "[nexus][attributes][created]"
        "[attributes][.exposed]"                 => "[nexus][attributes][exposed]"
        "[attributes][.id]"                      => "[nexus][attributes][id]"
        "[attributes][.logState]"                => "[nexus][attributes][log_state]"
        "[attributes][.message]"                 => "[nexus][attributes][message]"
        "[attributes][.name]"                    => "[nexus][attributes][name]"
        "[attributes][.recoverable]"             => "[nexus][attributes][recoverable]"
        "[attributes][.typeId]"                  => "[nexus][attributes][type][id]"
        "[attributes][.typeName]"                => "[nexus][attributes][type][name]"
        "[attributes][.updated]"                 => "[nexus][attributes][updated]"
        "[attributes][.visible]"                 => "[nexus][attributes][visible]"
        "[attributes][currentState]"             => "[nexus][attributes][current_state]"
        "[attributes][failureReasons]"           => "[nexus][attributes][failure_reasons]"
        "[attributes][lastRunState]"             => "[nexus][attributes][last_run_state][status]"
        "[attributes][lastRunState.endState]"    => "[nexus][attributes][last_run_state][end_state]"
        "[attributes][lastRunState.runDuration]" => "[nexus][attributes][last_run_state][run][duration]"
        "[attributes][lastRunState.runStarted]"  => "[nexus][attributes][last_run_state][run][started]"
        "[attributes][path]"                     => "[url][path]"
        "[attributes][remoteIp]"                 => "[client][ip]"
        "[attributes][schedule]"                 => "[nexus][attributes][schedule]"
        "[attributes][userAgent]"                => "[user][agent][original]"
        "[attributes][userId]"                   => "[user][id]"
        "[attributes][wasSuccessful]"            => "[nexus][attributes][was_successful]"
      }
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2000-nexus-main-parse.conf"
          "[error][source_plugin_id]" => "2000-nexus-initial_renames-mutate-01"
        }
        add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-initial_renames-mutate-01", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }
  ### END JSON ONLY PROCESSING ###

  ### START HEALTHCHECKER AND SERVICE ONLY PROCESSING ###
  if [isJson] == "false" {

    # convert the message to a string
    mutate {
      convert => { "message" => "string" }
      id => "2000-nexus-convert-string-mutate-02"
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2000-nexus-main-parse.conf"
          "[error][source_plugin_id]" => "2000-nexus-convert-string-mutate-02"
        }
        add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-convert-string-mutate-02", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }

    # strip quotes from the message before dissect
    mutate {
      gsub => [ "message", '"', "" ]
      id => "2000-nexus-gsub-quotes-mutate-03"
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2000-nexus-main-parse.conf"
          "[error][source_plugin_id]" => "2000-nexus-gsub-quotes-mutate-03"
        }
        add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-gsub-quotes-mutate-03", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }

    # strip unseen leading and trailing spaces
    mutate {
      strip => ["message"]
      id => "2000-nexus-strip-whitespace-mutate-04"
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "2000-nexus-main-parse.conf"
          "[error][source_plugin_id]" => "2000-nexus-strip-whitespace-mutate-04"
        }
        add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-strip-whitespace-mutate-04", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }

    if !("HealthChecker" in [message]) {

      # attempt service dissect only if service- token is present
      if ("service-" in [message]) {
        dissect {
          mapping => {
            "message" => "%{[client][ip]} %{[nexus][unknown]} service-%{[nexus][service_type]} [%{[event][start]}] %{[http][request][method]} %{[url][path]} %{[tls][protocol]} %{[http][response][status_code]} %{[http][request][body][bytes]} %{[http][response][body][bytes]} %{[event][duration]} %{[observer][type]} [%{[http][request][id]}]"
          }
          tag_on_failure => ["_dissectonefailure"]
          id => "2000-nexus-dissect-service"
        }
        if !("_dissectonefailure" in [tags]) {
          mutate {
            add_tag => ["nexus-service"]
            id => "2000-nexus-tag-service-mutate-05"
          }

          if "_mutate_error" in [tags] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2000-nexus-main-parse.conf"
                "[error][source_plugin_id]" => "2000-nexus-tag-service-mutate-05"
              }
              add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-tag-service-mutate-05", "_logstash_attributed_mutate_error"]
              remove_tag => ["_mutate_error"]
            }
          }
        }
      } else {
        # no service-token, force fallthrough to non-service dissect
        mutate {
          add_tag => ["_dissectonefailure"]
          id => "2000-nexus-tag-force-nonservice-mutate-06"
        }

        if "_mutate_error" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2000-nexus-main-parse.conf"
              "[error][source_plugin_id]" => "2000-nexus-tag-force-nonservice-mutate-06"
            }
            add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-tag-force-nonservice-mutate-06", "_logstash_attributed_mutate_error"]
            remove_tag => ["_mutate_error"]
          }
        }
      }

      # non-service dissect (runs on service dissect failure OR forced fallthrough)
      if "_dissectonefailure" in [tags] {
        dissect {
          mapping => {
            "message" => "%{[client][ip]} %{[nexus][unknown]} %{[user][email]} [%{[event][start]}] %{[http][request][method]} %{[url][path]} %{[tls][protocol]} %{[http][response][status_code]} %{[http][request][body][bytes]} %{[http][response][body][bytes]} %{[event][duration]} %{[observer][type]} [%{[http][request][id]}]"
          }
          tag_on_failure => ["_dissecttwofailure", "_logstash_failure__2000-nexus-main-parse__dissect__2000-nexus-dissect-nonservice-dissect-01"]
          id => "2000-nexus-dissect-nonservice-dissect-01"
        }

        if "_logstash_failure__2000-nexus-main-parse__dissect__2000-nexus-dissect-nonservice-dissect-01" in [tags] {
          mutate {
            add_field => {
              "[error][source_config]"    => "2000-nexus-main-parse.conf"
              "[error][source_plugin_id]" => "2000-nexus-dissect-nonservice-dissect-01"
            }
          }
        }
        if !("_dissecttwofailure" in [tags]) {
          mutate {
            add_tag => ["nexus-nonservice"]
            id => "2000-nexus-tag-nonservice-mutate-07"
          }

          if "_mutate_error" in [tags] {
            mutate {
              add_field => {
                "[error][source_config]"    => "2000-nexus-main-parse.conf"
                "[error][source_plugin_id]" => "2000-nexus-tag-nonservice-mutate-07"
              }
              add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-tag-nonservice-mutate-07", "_logstash_attributed_mutate_error"]
              remove_tag => ["_mutate_error"]
            }
          }
          # clean up placeholder dash captured in email field for unauthenticated requests
          if [user][email] == "-" {
            mutate {
              remove_field => ["[user][email]"]
              id => "2000-nexus-remove-empty-email-mutate-08"
            }

            if "_mutate_error" in [tags] {
              mutate {
                add_field => {
                  "[error][source_config]"    => "2000-nexus-main-parse.conf"
                  "[error][source_plugin_id]" => "2000-nexus-remove-empty-email-mutate-08"
                }
                add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-remove-empty-email-mutate-08", "_logstash_attributed_mutate_error"]
                remove_tag => ["_mutate_error"]
              }
            }
          }
        }
      }
    }

    if ("HealthChecker" in [message]) {
      mutate {
        add_tag => ["nexus-healthchecker"]
        id => "2000-nexus-tag-healthchecker-mutate-09"
      }

      if "_mutate_error" in [tags] {
        mutate {
          add_field => {
            "[error][source_config]"    => "2000-nexus-main-parse.conf"
            "[error][source_plugin_id]" => "2000-nexus-tag-healthchecker-mutate-09"
          }
          add_tag => ["_logstash_failure__2000-nexus-main-parse__mutate__2000-nexus-tag-healthchecker-mutate-09", "_logstash_attributed_mutate_error"]
          remove_tag => ["_mutate_error"]
        }
      }
    }
  }
  ### END HEALTHCHECKER AND SERVICE ONLY PROCESSING ###
}
