filter {
  # update tags to keep event.original
  mutate {
    add_tag => ["preserve_original_event"]
    id => "6000-nexus-tag-preserve-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-nexus-tag-preserve-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # check if the dissect had failure on the service but not on the non-service pattern to clear the unecessary tag
  if ("_dissectonefailure" in [tags]) and !("_dissecttwofailure" in [tags]) {
    mutate {
      remove_tag => ["_dissectonefailure"]
      id => "6000-nexus-remove-dissect-tag-mutate-02"
    }

    if "_mutate_error" in [tags] {

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "6000-nexus-remove-dissect-tag-mutate-02"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }

  # remove unecessary fields from long message
  mutate {
    id => "6000-nexus-remove_fields-mutate-03"
    remove_field => ["timestamp","message","isJson"]
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-nexus-remove_fields-mutate-03"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "6000-nexus-cleanup.conf"
      }
    }
  }
}
