filter {
  # update tags to keep event.original
  mutate {
    add_tag => ["preserve_original_event"]
    id => "6000-nexus-tag-preserve"
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-nexus-cleanup.conf"
        "[error][source_plugin_id]" => "6000-nexus-tag-preserve"
      }
      add_tag => ["_logstash_failure__6000-nexus-cleanup__mutate__6000-nexus-tag-preserve", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  # check if the dissect had failure on the service but not on the non-service pattern to clear the unecessary tag
  if ("_dissectonefailure" in [tags]) and !("_dissecttwofailure" in [tags]) {
    mutate {
      remove_tag => ["_dissectonefailure"]
      id => "6000-nexus-remove-dissect-tag"
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "6000-nexus-cleanup.conf"
          "[error][source_plugin_id]" => "6000-nexus-remove-dissect-tag"
        }
        add_tag => ["_logstash_failure__6000-nexus-cleanup__mutate__6000-nexus-remove-dissect-tag", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }

  # remove unecessary fields from long message
  mutate {
    id => "remove_fields"
    remove_field => ["timestamp","message","isJson"]
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-nexus-cleanup.conf"
        "[error][source_plugin_id]" => "remove_fields"
      }
      add_tag => ["_logstash_failure__6000-nexus-cleanup__mutate__remove_fields", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
}
