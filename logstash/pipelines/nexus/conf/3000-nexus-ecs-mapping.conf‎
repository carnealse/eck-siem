filter {
  if [isJson] == "true" {
    # place @timestamp as the time the event was ingested.
    mutate {
      id => "add_event_ingested"
      add_field => {
        "[event][ingested]" => "%{@timestamp}"
      }
    }

    if "_mutate_error" in [tags] and ![error][source_plugin_id] {
      mutate {
        add_field => {
          "[error][source_config]"    => "3000-nexus-ecs-mapping.conf"
          "[error][source_plugin_id]" => "add_event_ingested"
        }
      }
    }

    # set the @timestamp to the earliest extracted timestamp in the message
    date {
      id => "set_timestamp"
      match  => ["[timestamp]", "ISO8601"]
      target => "@timestamp"
    }

    if "_dateparsefailure" in [tags] and ![error][source_plugin_id] {
      mutate {
        add_field => {
          "[error][source_config]"    => "3000-nexus-ecs-mapping.conf"
          "[error][source_plugin_id]" => "set_timestamp"
        }
      }
    }

    # update tags
    mutate {
      add_tag => ["nexus-main"]
      id => "3000-nexus-tag-main"
    }

    if "_mutate_error" in [tags] and ![error][source_plugin_id] {
      mutate {
        add_field => {
          "[error][source_config]"    => "3000-nexus-ecs-mapping.conf"
          "[error][source_plugin_id]" => "3000-nexus-tag-main"
        }
      }
    }
  }
}
