filter {
  if [isJson] == "true" {
    # place @timestamp as the time the event was ingested.
    mutate {
      id => "3000-nexus-add_event_ingested-mutate-01"
      add_field => {
        "[event][ingested]" => "%{@timestamp}"
      }
    }

    if "_mutate_error" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "3000-nexus-ecs-mapping.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "3000-nexus-add_event_ingested-mutate-01"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }

    # set the @timestamp to the earliest extracted timestamp in the message
    date {
      id => "3000-nexus-set_timestamp-date-01"
      match  => ["[timestamp]", "ISO8601"]
      target => "@timestamp"
      tag_on_failure => ["_dateparsefailure", "_logstash_failure__3000-nexus-ecs-mapping__date__3000-nexus-set_timestamp-date-01"]
    }

    if "_logstash_failure__3000-nexus-ecs-mapping__date__3000-nexus-set_timestamp-date-01" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "3000-nexus-ecs-mapping.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "3000-nexus-set_timestamp-date-01"
        }
        remove_tag => ["_logstash_failure__3000-nexus-ecs-mapping__date__3000-nexus-set_timestamp-date-01"]
      }
    }

    # update tags
    mutate {
      add_tag => ["nexus-main"]
      id => "3000-nexus-tag-main-mutate-02"
    }

    if "_mutate_error" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "3000-nexus-ecs-mapping.conf"
          }
        }
      }

      mutate {
        add_field => {
          "[error][source_plugin_id]" => "3000-nexus-tag-main-mutate-02"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
  }
}
