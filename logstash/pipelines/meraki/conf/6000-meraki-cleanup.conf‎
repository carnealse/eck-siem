filter {
  mutate {
    id => "6000-meraki-cleanup-fields-mutate-01"
    remove_field => [ "[forwarded]", "[ls-ingest]", "[beats_input_codec_plain_applied]", "[message]", "[occurredAt]", "[ts]" ]
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-meraki-cleanup-fields-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  mutate {
    id => "6000-meraki-set-document-id-mutate-02"
    add_field => {
      "document_id" => "%{[@metadata][fingerprint]}"
    }
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-meraki-set-document-id-mutate-02"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  mutate {
    id => "6000-meraki-remove-extra-tags-mutate-03"
    remove_tag => [ "forwarded", "ls-ingest", "beats_input_codec_plain_applied" ]
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-meraki-remove-extra-tags-mutate-03"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
  ruby {
    id => "6000-meraki-cleanup-source-config-fallback"
    code => '
      plugin_ids = event.get("[error][source_plugin_id]")
      if plugin_ids
        ids_array = plugin_ids.is_a?(Array) ? plugin_ids : [plugin_ids]
        has_match = ids_array.any? { |id| id.to_s.start_with?("6000-meraki") }
        if has_match
          configs = event.get("[error][source_config]")
          configs_array = configs.nil? ? [] : (configs.is_a?(Array) ? configs : [configs])
          unless configs_array.include?("6000-meraki-cleanup.conf")
            event.set("[_temp][config_boolean]", "true")
          end
        end
      end
    '
  }

  if [_temp][config_boolean] == "true" {
    mutate {
      add_field => {
        "[error][source_config]" => "6000-meraki-cleanup.conf"
      }
      remove_field => ["[_temp]"]
    }
  }
}
