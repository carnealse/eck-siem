filter {
  # field clean up removes top level objects emptied out through field renames above #
  mutate {
    id => "6000-meraki-cleanup-fields-mutate-06"
    remove_field => [ "[forwarded]", "[ls-ingest]", "[beats_input_codec_plain_applied]", "[message]", "[occurredAt]" ]   
  }
  # error handling #
  if "_jsonparsefailure" in [tags] {
    mutate {
      id => "6000-meraki-json-error-mutate-07"
      add_tag => ["_jsonparsefailure"]
      add_field => { "[error][message]" => "error parsing json" }
    }
  }
  # Do not set data_stream_namespace here; that will be handled in the return pipeline
  mutate {
    id => "6000-meraki-set-document-id-mutate-08"
    add_field => {
      "document_id" => "%{[@metadata][fingerprint]}"
    }
  }
  mutate {
    id => "6000-meraki-remove-extra-tags-mutate-09"
    remove_tag => [ "forwarded", "ls-ingest", "beats_input_codec_plain_applied", "[occurredAt]", "[ts]" ]
  }
}
