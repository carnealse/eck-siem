filter {
  if "_jsonparsefailure" in [tags] {
    mutate {
      id => "8000-netskope-jsonparsefailure"
      replace => { "[error][message]" => "json parsing failed" }
      add_tag => ["filter_error"]
    }
  }
  if "_dateparsefailure" in [tags] {
    mutate {
      id => "8000-netskope-dateparsefailure"
      replace => { "[error][message]" => "date parsing failed" }
      add_tag => ["filter_error"]
    }
  }
  if "_mutate_error" in [tags] {
    mutate {
      id => "8000-netskope-mutate-error"
      replace => { "[error][message]" => "mutate error occurred" }
      add_tag => ["filter_error"]
    }
  }
  if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
    mutate {
      id => "8000-netskope-rubyexception"
      replace => { "[error][message]" => "An exception occurred in the ruby code" }
      add_tag => ["filter_error"]
    }
  }
  if "_geoip_lookup_failure" in [tags] {
    mutate {
      id => "8000-netskope-geoip-lookup-failure"
      replace => { "[error][message]" => "geoip lookup failed" }
      add_tag => ["filter_error"]
    }
  }
  if "_grokparsefailure" in [tags] {
    mutate {
      id => "8000-netskope-grokparsefailure"
      replace => { "[error][message]" => "grok parsing failed" }
      add_tag => ["filter_error"]
    }
  }
  if "_grok_kv_parse_failure" in [tags] {
    mutate {
      id => "8000-netskope-grok-kv-parse-failure"
      replace => { "[error][message]" => "grok kv parsing failed" }
      add_tag => ["filter_error"]
    }
  }

  # Consolidate all filter errors under one tag and stamp pipeline metadata
  if "filter_error" in [tags] {
    mutate {
      id => "8000-netskope-pipeline-error-consolidation"
      add_tag => ["pipeline_processing_error"]
      replace => {
        "[error][source_pipeline]" => "netskope"
        "[error][event_status]"    => "processing_failure"
      }
    }
  }

  # Fallback generic error message if none was set
  if "pipeline_processing_error" in [tags] and ![error][message] {
    mutate {
      id => "8000-netskope-generic-error-message"
      replace => { "[error][message]" => "netskope generic pipeline processing failure" }
    }
  }

  # Set routing path for 9000 output
  if "pipeline_processing_error" in [tags] {
    mutate {
      id => "8000-netskope-routing-error"
      replace => { "[@metadata][routing_path]" => "error_index" }
    }
  } else {
    mutate {
      id => "8000-netskope-routing-standard"
      replace => { "[@metadata][routing_path]" => "standard_index" }
    }
  }
}
