filter {
# field clean up
  mutate {
    remove_field => ["[message]","[timestamp]","[temp]"]
    id => "6000-netskope-cleanup-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-netskope-cleanup-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

# recursively set empty fields to null
  ruby {
    id => "6000-netskope-nullify-ruby-01"
    code => "
      def recursively_nullify_empty_fields(obj)
        case obj
        when Hash
          obj.each { |key, value| obj[key] = recursively_nullify_empty_fields(value) }
        when Array
          obj.map! { |item| recursively_nullify_empty_fields(item) }
        else
          obj.nil? || obj == '' ? 'null' : obj
        end
      end

      event.to_hash.each do |key, value|
        event.set(key, recursively_nullify_empty_fields(value))
      end
    "
    tag_on_exception => "_rubyexception"
  }

  if "_rubyexception" in [tags] or "ruby_exception" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-netskope-nullify-ruby-01"
      }
      add_tag => ["_logstash_attributed_ruby_exception"]
      remove_tag => ["ruby_exception", "_rubyexception"]
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "6000-netskope-cleanup.conf"
      }
    }
  }
}
