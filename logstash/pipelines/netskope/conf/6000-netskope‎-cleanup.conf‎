filter {
# field clean up
  mutate {
    remove_field => ["[message]","[timestamp]","[temp]"]
    id => "6000-netskope-cleanup"
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-netskope-cleanup.conf"
        "[error][source_plugin_id]" => "6000-netskope-cleanup"
      }
      add_tag => ["_logstash_failure__6000-netskope-cleanup__mutate__6000-netskope-cleanup", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

# recursively set empty fields to null
  ruby {
    id => "6000-netskope-nullify-ruby"
    code => "
      def recursively_nullify_empty_fields(obj)
        case obj
        when Hash
          obj.each { |key, value| obj[key] = recursively_nullify_empty_fields(value) }
        when Array
          obj.map! { |item| recursively_nullify_empty_fields(item) }
        else
          obj.nil? || obj == '' ? 'null' : obj
        end
      end

      event.to_hash.each do |key, value|
        event.set(key, recursively_nullify_empty_fields(value))
      end
    "
    tag_on_exception => "_logstash_failure__6000-netskope-cleanup__ruby__6000-netskope-nullify-ruby"
  }

  if ("_logstash_failure__6000-netskope-cleanup__ruby__6000-netskope-nullify-ruby" in [tags] or "ruby_exception" in [tags] or "_rubyexception" in [tags]) {
    mutate {
      add_field => {
        "[error][source_config]"    => "6000-netskope-cleanup.conf"
        "[error][source_plugin_id]" => "6000-netskope-nullify-ruby"
      }
      add_tag => ["_logstash_failure__6000-netskope-cleanup__ruby__6000-netskope-nullify-ruby", "_logstash_attributed_ruby_exception"]
      remove_tag => ["ruby_exception", "_rubyexception"]
    }
  }
}
