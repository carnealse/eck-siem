filter {
# add v2 tag
  mutate {
    add_tag => ["netskope"]
    id => "1000-netskope-initial-tag-mutate-01"
  }

  if "_mutate_error" in [tags] {

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-initial-tag-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

# process the message json
  json {
    id => "1000-netskope-json_process-json-01"
    source => "message"
    tag_on_failure => ["_jsonparsefailure"]
  }

  if "_jsonparsefailure" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-json_process-json-01"
      }
      add_tag => ["_logstash_attributed_json_parse_failure"]
      remove_tag => ["_jsonparsefailure"]
    }
  }

# process timestamp
  date {
    match => ["timestamp", "UNIX"]
    id => "1000-netskope-date-timestamp-date-01"
    tag_on_failure => ["_dateparsefailure"]
  }

  if "_dateparsefailure" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-date-timestamp-date-01"
      }
      add_tag => ["_logstash_attributed_date_parse_failure"]
      remove_tag => ["_dateparsefailure"]
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-netskope-normalization.conf"
      }
    }
  }
}
