filter {
# add v2 tag
  mutate {
    add_tag => ["netskope"]
    id => "1000-netskope-initial-tag-mutate-01"
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-netskope-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-initial-tag-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

# process the message json
  json {
    id => "1000-netskope-json_process-json-01"
    source => "message"
    tag_on_failure => ["_jsonparsefailure", "_logstash_failure__1000-netskope-normalization__json__1000-netskope-json_process-json-01"]
  }

  if "_logstash_failure__1000-netskope-normalization__json__1000-netskope-json_process-json-01" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-netskope-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-json_process-json-01"
      }
      remove_tag => ["_logstash_failure__1000-netskope-normalization__json__1000-netskope-json_process-json-01"]
    }
  }

# process timestamp
  date {
    match => ["timestamp", "UNIX"]
    id => "1000-netskope-date-timestamp-date-01"
    tag_on_failure => ["_dateparsefailure", "_logstash_failure__1000-netskope-normalization__date__1000-netskope-date-timestamp-date-01"]
  }

  if "_logstash_failure__1000-netskope-normalization__date__1000-netskope-date-timestamp-date-01" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "1000-netskope-normalization.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-netskope-date-timestamp-date-01"
      }
      remove_tag => ["_logstash_failure__1000-netskope-normalization__date__1000-netskope-date-timestamp-date-01"]
    }
  }
}
