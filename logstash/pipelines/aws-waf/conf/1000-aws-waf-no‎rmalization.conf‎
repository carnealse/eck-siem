filter {

  fingerprint {
    source => ["message"]
    target => "[@metadata][fingerprint]"
    method => "SHA256"
  }

  # Do not set data_stream_namespace here; that will be handled in the return pipeline
  mutate {
    id => "1000-aws-waf-normalization-mutate-01"
    add_field => {
      "document_id" => "%{[@metadata][fingerprint]}"
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-01"
      }
      add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-01", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

if [event][original] {
    mutate {
      id => "1000-aws-waf-normalization-mutate-02"
      remove_field => ["[event][original]"]
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_config]"    => "1000-aws-waf-normalization.conf"
          "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-02"
        }
        add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-02", "_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
}

#added to set original message into event.original
  mutate {
    id => "1000-aws-waf-normalization-mutate-03"
    add_field => { "[event][original]" => "temp_value" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-03"
      }
      add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-03", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
    id => "1000-aws-waf-normalization-mutate-04"
    copy => { "message" => "[event][original]" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-04"
      }
      add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-04", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
    id => "1000-aws-waf-normalization-mutate-05"
    replace => {
      "tags" => ["aws_waf", "logstash", "preserve_event_original"]
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-05"
      }
      add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-05", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  json {
    id => "json_processor"
    source => "message"
    tag_on_failure => ["_jsonparsefailure", "_logstash_failure__1000-aws-waf-normalization__json__json_processor"]
  }

  if "_logstash_failure__1000-aws-waf-normalization__json__json_processor" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "json_processor"
      }
    }
  }

  mutate {
    id => "1000-aws-waf-normalization-mutate-06"
    rename => {
      "[@timestamp]"  => "[event][created]"
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "1000-aws-waf-normalization-mutate-06"
      }
      add_tag => ["_logstash_failure__1000-aws-waf-normalization__mutate__1000-aws-waf-normalization-mutate-06", "_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  date {
    id => "timestamp_date_match"
    match => ["timestamp", "UNIX_MS", "UNIX"]
    target => "[@timestamp]"
    tag_on_failure => ["_dateparsefailure", "_logstash_failure__1000-aws-waf-normalization__date__timestamp_date_match"]
  }

  if "_logstash_failure__1000-aws-waf-normalization__date__timestamp_date_match" in [tags] {
    mutate {
      add_field => {
        "[error][source_config]"    => "1000-aws-waf-normalization.conf"
        "[error][source_plugin_id]" => "timestamp_date_match"
      }
    }
  }
}
