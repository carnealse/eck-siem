filter {

  fingerprint {
    source => ["message"]
    target => "[@metadata][fingerprint]"
    method => "SHA256"
  }

  mutate {
    id => "1000-aws-waf-document-id-mutate-01"
    add_field => {
      "document_id" => "%{[@metadata][fingerprint]}"
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-document-id-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

if [event][original] {
    mutate {
      id => "1000-aws-waf-remove-event-original-mutate-02"
      remove_field => ["[event][original]"]
    }

    if "_mutate_error" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-aws-waf-remove-event-original-mutate-02"
        }
        add_tag => ["_logstash_attributed_mutate_error"]
        remove_tag => ["_mutate_error"]
      }
    }
}

#added to set original message into event.original
  mutate {
    id => "1000-aws-waf-add-event-original-placeholder-mutate-03"
    add_field => { "[event][original]" => "temp_value" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-add-event-original-placeholder-mutate-03"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
    id => "1000-aws-waf-copy-event-original-mutate-04"
    copy => { "message" => "[event][original]" }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-copy-event-original-mutate-04"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  mutate {
    id => "1000-aws-waf-replace-tags-mutate-05"
    replace => {
      "tags" => ["aws_waf", "logstash", "preserve_event_original"]
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-replace-tags-mutate-05"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  json {
    id => "1000-aws-waf-json_processor-json-01"
    source => "message"
    tag_on_failure => ["_jsonparsefailure"]
  }

  if "_jsonparsefailure" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-json_processor-json-01"
      }
      add_tag => ["_logstash_attributed_json_parse_failure"]
      remove_tag => ["_jsonparsefailure"]
    }
  }

  mutate {
    id => "1000-aws-waf-rename-timestamp-mutate-06"
    rename => {
      "[@timestamp]"  => "[event][created]"
    }
  }

  if "_mutate_error" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-rename-timestamp-mutate-06"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }

  date {
    id => "1000-aws-waf-timestamp_date_match-date-01"
    match => ["timestamp", "UNIX_MS", "UNIX"]
    target => "[@timestamp]"
    tag_on_failure => ["_dateparsefailure"]
  }

  if "_dateparsefailure" in [tags] {
    mutate {
      add_field => {
        "[error][source_plugin_id]" => "1000-aws-waf-timestamp_date_match-date-01"
      }
      add_tag => ["_logstash_attributed_date_parse_failure"]
      remove_tag => ["_dateparsefailure"]
    }
  }

  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-aws-waf-normalization.conf"
      }
    }
  }
}
