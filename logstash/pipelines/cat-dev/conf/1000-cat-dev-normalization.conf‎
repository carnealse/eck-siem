filter {
  if [message] =~ /^\s*\{.*\}\s*$/ {
    json {
      source => "message"
      target => "check_json"
      id => "1000-cat-dev-json-json-01"
      tag_on_failure => ["_jsonparsefailure"]
    }

    if "_jsonparsefailure" in [tags] {
      mutate {
        add_field => {
          "[error][source_plugin_id]" => "1000-cat-dev-json-json-01"
        }
        add_tag => ["_logstash_attributed_json_parse_failure"]
        remove_tag => ["_jsonparsefailure"]
      }
    }
  }


  if [error][source_plugin_id] {
    mutate {
      add_field => {
        "[error][source_config]" => "1000-cat-dev-normalization.conf"
      }
    }
  }
}
