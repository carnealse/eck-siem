filter {
  if [message] =~ /^\s*\{.*\}\s*$/ {
    json {
      source => "message"
      target => "check_json"
      id => "1000-cat-dev-json-json-01"
      tag_on_failure => ["_jsonparsefailure", "_logstash_failure__1000-cat-dev-normalization__json__1000-cat-dev-json-json-01"]
    }

    if "_logstash_failure__1000-cat-dev-normalization__json__1000-cat-dev-json-json-01" in [tags] {
      if ![error][source_config] {
        mutate {
          add_field => {
            "[error][source_config]" => "1000-cat-dev-normalization.conf"
          }
        }
      }

      if [error][source_plugin_id] {
        mutate {
          update => {
            "[error][source_plugin_id]" => "%{[error][source_plugin_id]} | 1000-cat-dev-json-json-01"
          }
        }
      } else {
        mutate {
          add_field => {
            "[error][source_plugin_id]" => "1000-cat-dev-json-json-01"
          }
        }
      }
    }
  }
}
