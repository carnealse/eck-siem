filter {
  mutate {
    id => "6000-cat-dev-remove-check-json-mutate-01"
    remove_field => [ "[check_json]" ]
  }

  if "_mutate_error" in [tags] {
    if ![error][source_config] {
      mutate {
        add_field => {
          "[error][source_config]" => "6000-cat-dev-cleanup.conf"
        }
      }
    }

    mutate {
      add_field => {
        "[error][source_plugin_id]" => "6000-cat-dev-remove-check-json-mutate-01"
      }
      add_tag => ["_logstash_attributed_mutate_error"]
      remove_tag => ["_mutate_error"]
    }
  }
}
